{ lib, userPaths, ... }:
let
  commands = import ./run-commands.nix { inherit userPaths; };
  entries = lib.mapAttrsToList
    (directory: command: "  ${lib.escapeShellArg directory} ${lib.escapeShellArg command}")
    commands;
in
{
  xdg.configFile."zsh/run-commands.zsh".text = ''
    # Generated by Home Manager. Edit run-commands.nix with vrun, then rebuild.
    run_commands=(
    ${lib.concatStringsSep "\n" entries}
    )
  '';

  programs.zsh.initContent = lib.mkAfter (builtins.readFile ./run.zsh);
}
